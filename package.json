{
  "name": "edgar-ts",
  "version": "1.0.0",
  "description": "TypeScript SEC EDGAR client for filing discovery and contract exhibit acquisition. SEC-compliant rate limiting, retry, and deterministic normalization.",
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./telemetry": {
      "types": {
        "import": "./dist/telemetry/index.d.mts",
        "require": "./dist/telemetry/index.d.cts"
      },
      "import": "./dist/telemetry/index.mjs",
      "require": "./dist/telemetry/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src tests",
    "format": "biome format --write src tests",
    "check": "biome check src tests",
    "size": "size-limit",
    "changeset": "changeset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/medelman17/edgar-ts.git"
  },
  "keywords": [
    "sec",
    "edgar",
    "filings",
    "exhibits",
    "contracts",
    "legal",
    "compliance",
    "typescript"
  ],
  "author": "Michael Edelman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/medelman17/edgar-ts/issues"
  },
  "homepage": "https://github.com/medelman17/edgar-ts#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "size-limit": "^12.0.0",
    "tsdown": "^0.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "limit": "20 KB"
    }
  ]
}
